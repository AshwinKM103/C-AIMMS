[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "lightmem"
version = "0.1.0"
description = "LightMemory"
readme = "README.md"
requires-python = ">=3.10,<3.12"
license = {text = "Apache-2.0"}
keywords = ["llm", "memory", "retrieval"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Intended Audience :: Science/Research",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
]

# Complete dependencies with exact versions for reproducibility
dependencies = [
    "numpy==2.2.6",
]

[project.optional-dependencies]
fluxmem = [
    "openai>=1.0.0",
    "faiss-cpu>=1.7.0",
    "scikit-learn>=1.0.0",
]
dev = [
    "pytest>=7.0.0",
    "black>=23.0.0",
    "isort>=5.12.0",
    "flake8>=6.0.0",
]


[project.urls]
Homepage = "https://github.com/zjunlp/LightMem"
Repository = "https://github.com/zjunlp/LightMem"
Documentation = "https://github.com/zjunlp/LightMem/blob/main/README.md"

# Src layout configuration for setuptools
[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
"*" = ["*.yaml", "*.yml", "*.json"]
